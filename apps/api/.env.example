NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
FRONTEND_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tj_rentcar?schema=public
SESSION_SECRET=replace_with_min_32_chars_random_string_secret
ACCESS_TOKEN_SECRET=replace_with_min_32_chars_access_token_secret
REFRESH_TOKEN_SECRET=replace_with_min_32_chars_refresh_token_secret
COOKIE_NAME=tj_rentcar_admin_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
STORAGE_PROVIDER=local
STORAGE_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR
