datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ServiceType {
  WITH_DRIVER
  SELF_DRIVE
}

enum BillingUnit {
  DAILY
  WEEKLY
  MONTHLY
}

enum Transmission {
  MANUAL
  AUTOMATIC
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  NOT_TRACKED
  UNPAID
  DP_PAID
  PAID
  REFUNDED
}

enum BlockReason {
  MAINTENANCE
  INTERNAL_USE
  OTHER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  NEW
  READ
  FOLLOWED_UP
  ARCHIVED
}

model AdminUser {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(ADMIN)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  blocks       VehicleBlock[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model Vehicle {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  brand           String
  model           String
  year            Int?
  category        String
  transmission    Transmission?
  seats           Int?
  doors           Int?
  fuelType        String?
  luggageCapacity String?
  description     String?          @db.Text
  features        String?          @db.Text
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalPath   String?
  robotsIndex     Boolean          @default(true)
  robotsFollow    Boolean          @default(true)
  focusKeyword    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  images          VehicleImage[]
  rates           VehicleRate[]
  services        VehicleService[]
  bookings        Booking[]
  blocks          VehicleBlock[]

  @@index([slug])
  @@index([isActive])
  @@index([category])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid())
  vehicleId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model VehicleRate {
  id          String      @id @default(uuid())
  vehicleId   String
  serviceType ServiceType
  billingUnit BillingUnit
  amount      Int
  isActive    Boolean     @default(true)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, serviceType, billingUnit])
  @@index([vehicleId])
  @@map("vehicle_rates")
}

model Service {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  shortDescription String?
  description      String?          @db.Text
  imageUrl         String?
  isActive         Boolean          @default(true)
  sortOrder        Int              @default(0)
  metaTitle        String?
  metaDescription  String?
  ogImageUrl       String?
  canonicalPath    String?
  robotsIndex      Boolean          @default(true)
  robotsFollow     Boolean          @default(true)
  focusKeyword     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vehicles         VehicleService[]

  @@index([slug])
  @@map("services")
}

model VehicleService {
  id        String   @id @default(uuid())
  vehicleId String
  serviceId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, serviceId])
  @@map("vehicle_services")
}

model Booking {
  id              String        @id @default(uuid())
  bookingCode     String        @unique
  vehicleId       String
  customerName    String
  customerPhone   String
  customerEmail   String?
  serviceType     ServiceType
  billingUnit     BillingUnit
  pickupAt        DateTime
  returnAt        DateTime
  pickupLocation  String
  returnLocation  String?
  durationUnits   Int
  estimatedTotal  Int?
  priceBreakdown  String?       @db.Text
  customerNote    String?       @db.Text
  termsAcceptedAt DateTime      @default(now())
  termsVersion    String?
  adminNote       String?       @db.Text
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(NOT_TRACKED)
  amountPaid      Int?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([bookingCode])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupAt, returnAt])
  @@map("bookings")
}

model VehicleBlock {
  id               String      @id @default(uuid())
  vehicleId        String
  startAt          DateTime
  endAt            DateTime
  reason           BlockReason @default(MAINTENANCE)
  note             String?     @db.Text
  createdByAdminId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  vehicle          Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdByAdmin   AdminUser?  @relation(fields: [createdByAdminId], references: [id])

  @@index([vehicleId])
  @@index([startAt, endAt])
  @@map("vehicle_blocks")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("site_settings")
}

model ContentPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalPath   String?
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@map("content_pages")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("faqs")
}

model Article {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  excerpt          String?       @db.Text
  content          String        @db.Text
  featuredImageUrl String?
  featuredImageAlt String?
  category         String?
  authorName       String?
  status           ArticleStatus @default(DRAFT)
  publishedAt      DateTime?
  metaTitle        String?
  metaDescription  String?
  ogImageUrl       String?
  canonicalPath    String?
  robotsIndex      Boolean       @default(true)
  robotsFollow     Boolean       @default(true)
  focusKeyword     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@map("articles")
}

model Testimonial {
  id           String   @id @default(uuid())
  customerName String
  rating       Int?
  review       String   @db.Text
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
  @@map("testimonials")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  contact   String
  email     String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@map("contact_messages")
}

model AuditLog {
  id         String     @id @default(uuid())
  adminId    String?
  adminEmail String?
  action     String
  entity     String
  entityId   String?
  metadata   String?    @db.Text
  createdAt  DateTime   @default(now())
  admin      AdminUser? @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([entity, entityId])
  @@map("audit_logs")
}
